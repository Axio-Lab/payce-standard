# Every variable below is REQUIRED at startup (no in-code defaults).
# Copy to `.env` and fill in values. In production, set the same keys on your
# host (Docker `--env-file`, Kubernetes Secrets -> env, systemd `Environment=`,
# Railway/Fly/Heroku config vars, etc.); the binary only reads the process environment.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
RUST_LOG=info

# Database
DATABASE_URL=postgresql://payce:payce@localhost:5433/payce
DATABASE_SSL=disable
# Optional. Max Postgres connections in the deadpool pool. Default 32.
DATABASE_POOL_MAX_SIZE=32

# Redis
REDIS_URL=redis://localhost:6379

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# Tx links in SMS use this base (Solscan: https://solscan.io — append /tx/{signature}; devnet adds ?cluster=devnet).
SOLANA_EXPLORER_BASE=https://solscan.io
WALLET_MASTER_SEED=
WALLET_ENCRYPTION_KEY=

# All three are used for USSD balance, Send money, and Pay merchant; utilities use USDC (USDC_MINT_ADDRESS) where implemented.
USDC_MINT_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDT_MINT_ADDRESS=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
USDG_MINT_ADDRESS=2u1tszSeqZ3qBWF3uNGPFc8TzMk2tdiwknnRMWGWjGWH

# Wrapped SOL (WSOL) — DeFi swap routes, Lend & Earn SOL leg, PAJ token pick. Mainnet/devnet canonical mint:
SOL_MINT=So11111111111111111111111111111111111111112

FEE_PAYER_PRIVATE_KEY=
# SPL amount (smallest units, same decimals as the mint) sent to the fee payer on gasless transfers; also the extra leg on Lend & Earn fee collection txs.
GAS_FEE_USDC=500000

# Africa's Talking — SMS
# Sandbox: add every destination phone in the AT console (Team → SMS → Test phone numbers).
# Sandbox often rejects unknown numbers; API may still return HTTP 201 with recipient status Invalid.
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=Payce
# Your Africa's Talking USSD / shared service code (e.g. 384 for *384#) — logged at startup only.
# SMS "from" is AT_SENDER_ID, not this. Required env key; use empty if you do not have a code yet.
AT_SHORTCODE=

# If non-empty, used as the only SMS API URL. If empty, AT_SMS_SANDBOX_URL vs
# AT_SMS_PRODUCTION_URL is chosen using AT_USERNAME (sandbox username -> sandbox URL).
AT_SMS_API_URL=
AT_SMS_SANDBOX_URL=https://api.sandbox.africastalking.com/version1/messaging
AT_SMS_PRODUCTION_URL=https://api.africastalking.com/version1/messaging

AT_CALLBACK_ALLOWED_IPS=52.13.106.89,54.71.24.227,35.163.42.151,34.214.84.250

# Optional shared secret accepted as `?key=…` on the USSD callback URL.
# Africa's Talking only lets you configure a URL (no custom headers), so set
# this and use `https://your-host/ussd/callback?key=<value>` as the AT callback.
# Recommended in production — IP allowlists are brittle when AT changes egress.
# Generate with `openssl rand -hex 32`. Leave empty to disable.
AT_CALLBACK_URL_KEY=

# Set to `true` when running behind a managed PaaS (Railway, Fly, Render,
# Heroku, Cloudflare, etc.) where every public request reaches the app through
# the platform's reverse proxy. The first hop of `X-Forwarded-For` is then used
# as the client IP for both the AT_CALLBACK_ALLOWED_IPS check and per-IP rate
# limits. ONLY enable if every request is proxied — otherwise XFF can be
# spoofed to bypass the allowlist and rate limits.
TRUST_PROXY_XFF=false

EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_RATE_CACHE_TTL_SECS=300
EXCHANGE_RATE_FALLBACK_NGN=1600
EXCHANGE_RATE_QUOTE_CURRENCY=NGN

MAX_PIN_ATTEMPTS=3
PIN_LOCKOUT_MINUTES=30

TIER1_DAILY_LIMIT_NGN=50000
TIER2_DAILY_LIMIT_NGN=500000

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_PER_PHONE=30
RATE_LIMIT_MAX_PER_IP=60

# Airbills Payments
AIRBILLS_BASE_URL=https://api.airbills.org
AIRBILLS_API_KEY=

# PAJ Ramp
PAJ_API_KEY=
PAJ_BASE_URL=
# USDC amount sent to PAJ as businessUSDCFee on ramp create (default 1).
PAJ_RAMP_BUSINESS_USDC_FEE=1
# Public HTTPS origin of *this* API (no path). Used to build PAJ webhookURL for onramp/offramp.
PAYCE_PUBLIC_BASE_URL=
# Optional; if set, appended as ?k=... on webhook URLs (use URL-safe characters).
PAJ_WEBHOOK_SECRET=
# Required for POST /api/paj/onramp and /api/paj/offramp — send header X-Payce-Key: <value>
PAYCE_INTERNAL_API_KEY=
# Resend (https://resend.com) for PAJ order status emails; leave RESEND_API_KEY empty to skip email.
RESEND_API_KEY=
RESEND_FROM=

# Jupiter Swap v2
JUPITER_API_KEY=
JUPITER_SWAP_BASE_URL=https://api.jup.ag/swap/v2
JUPITER_REFERRAL_ACCOUNT=
# Referral fee in basis points (100 = 1%). Must be set (integer).
JUPITER_REFERRAL_FEE_BPS=100
JUPITER_LEND_BASE_URL=https://api.jup.ag/lend/v1
# Earn service fee (basis points on deposit/withdraw principal, default 100 = 1%). Settled to FEE_PAYER ATAs like transfer gas (see GAS_FEE_USDC).
PAYCE_EARN_FEE_BPS=100
